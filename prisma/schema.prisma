datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Client {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  branding_config Json
  created_at      DateTime @default(now()) @db.Timestamptz

  distributors Distributor[]
  questions    Question[]

  @@map("clients")
}

model Question {
  id         String  @id @default(uuid()) @db.Uuid
  client_id  String  @db.Uuid
  index      Int
  is_branded Boolean @default(false)

  text_en String
  text_hi String
  text_mr String

  vo_key_en String
  vo_key_hi String
  vo_key_mr String

  // Currently DORMANT — not read by src/services/gemini.ts as of the
  // 2026-09-16 prompt rewrite, which hardcodes a fixed extracted shape
  // (mentions_teacher/teacher_contribution/life_skills_mentioned) instead of
  // building one per question. Every seeded question already had
  // extraction_spec: null, so nothing behavioral changed. Left in the schema
  // for a possible future per-question reactivation, not a migration
  // ordered to be dropped. Shape when it was wired in: an array of
  // { name: string; type: "string"|"number"|"boolean"; description: string; nullable?: boolean }
  extraction_spec Json?

  // Gentle on-screen nudges shown to the distributor during recording (NOT
  // analysis input — unrelated to extraction_spec above). Shape:
  // { en: string[]; hi: string[] | null; mr: string[] | null } — each array
  // is a handful of short (2-4 word) prompts in that language, translated
  // alongside text_hi/text_mr for every internal-test question. hi/mr can
  // still be null for a question added later before its translation is
  // filled in — treat null as "nothing to show," not an error. See
  // src/services/questions.ts.
  talking_points Json?

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  client Client @relation(fields: [client_id], references: [id])

  @@unique([client_id, index])
  @@map("questions")
}

model Distributor {
  id                   String   @id @default(uuid()) @db.Uuid
  client_id            String   @db.Uuid
  name                 String
  // Required + unique + normalized (src/services/phone.ts - digits only,
  // last 10) as of the phone+password self-registration login flow
  // (src/routes/register.ts, src/routes/loginPhone.ts). Seeded accounts
  // (prisma/seed.ts) keep their original unnormalized "+91-98..." values -
  // they log in via username/password on POST /login, never via
  // /login/phone, so the differing format never collides with a normalized
  // self-registered value.
  phone                String   @unique
  // Set only for self-registered distributors (POST /register) - null for
  // every seeded account and for any future Phase B invite-token
  // distributor, both of which authenticate a different way. Never read
  // outside src/routes/register.ts and src/routes/loginPhone.ts.
  password_hash        String?
  invite_token         String   @unique
  language_pref        String
  // Internal-test-phase-only profile fields (frontend header/profile
  // screens show these) - nullable since there's no import/CRM-sync
  // mechanism yet to populate them for real IFB distributor data, only
  // hand-seeded test values. See prisma/seed.ts.
  business             String?
  city                 String?
  years_as_distributor Int?
  created_at           DateTime @default(now()) @db.Timestamptz

  client   Client    @relation(fields: [client_id], references: [id])
  segments Segment[]

  @@map("distributors")
}

enum SegmentStatus {
  recorded_local
  uploaded
  transcribing
  transcribed
  failed
}

model Segment {
  id               String        @id @default(uuid()) @db.Uuid
  distributor_id   String        @db.Uuid
  question_index   Int
  video_key        String
  status           SegmentStatus @default(recorded_local)
  duration_seconds Int
  trim_start_ms    Int?
  trim_end_ms      Int?
  // What the device actually captured, as reported by the client at
  // confirm time - file size, resolution, fps, codec, device model/OS
  // version. Best-effort, stored as-is (see POST /segments/confirm) for
  // later analysis of real distributor phones; nothing reads it back today.
  capture_metadata Json?
  created_at       DateTime      @default(now()) @db.Timestamptz
  updated_at       DateTime      @updatedAt @db.Timestamptz

  distributor      Distributor      @relation(fields: [distributor_id], references: [id])
  transcript       Transcript?
  sentiment_result SentimentResult?
  rendered_video   RenderedVideo?

  @@unique([distributor_id, question_index])
  @@map("segments")
}

model Transcript {
  id                   String   @id @default(uuid()) @db.Uuid
  segment_id           String   @unique @db.Uuid
  text                 String
  language_detected    String
  // ElevenLabs Scribe's own confidence in language_detected (0-1) - free
  // technical-QA signal the API already returns on every single-channel
  // response. Nullable: rows written before this column existed have no
  // value and are never backfilled automatically (see gemini extraction
  // reprocessing note in CLAUDE.md's future-work section).
  language_probability Decimal?
  srt_key              String
  vtt_key              String
  created_at           DateTime @default(now()) @db.Timestamptz

  segment Segment @relation(fields: [segment_id], references: [id])

  @@map("transcripts")
}

model SentimentResult {
  id                  String   @id @default(uuid()) @db.Uuid
  segment_id          String   @unique @db.Uuid
  sentiment_score     Decimal
  // Constrained to a fixed 11-value vocabulary by the Gemini prompt/response
  // schema (src/services/gemini.ts THEME_VALUES), not enforced at the DB
  // level - stays Json (array of strings) rather than a Postgres enum so a
  // future vocabulary change is a code-only edit, no migration.
  themes              Json
  // One of EMOTIONAL_TONE_VALUES (src/services/gemini.ts). Nullable: rows
  // written before this column existed have no value.
  emotional_tone      String?
  summary             String
  best_quote          String
  is_relevant         Boolean
  // true means unsuitable for external/client-facing use - see the
  // moderation_flag description in src/services/gemini.ts. Semantics
  // flipped 2026-09-16 (previously true meant "safe to publish", inverted
  // from the usual "flag = bad" convention) - rows written before that date
  // still hold values under the OLD (inverted) meaning; only reprocessed
  // rows are guaranteed correct under the new one.
  moderation_flag     Boolean
  // Nullable: rows written before this column existed have no value.
  contains_profanity  Boolean?
  contains_complaint  Boolean
  actionable_feedback String?
  highlight_score     Decimal
  // Fixed shape as of the 2026-09-16 prompt rewrite: { mentions_teacher:
  // boolean, teacher_contribution: string|null, life_skills_mentioned:
  // string[] } (src/services/gemini.ts). Previously driven per-question by
  // Question.extraction_spec - that generic mechanism is currently unused
  // (every seeded question has extraction_spec: null) and not wired into
  // analyzeSentiment anymore; the column still exists on Question for a
  // future per-question reactivation, not read by the sentiment call today.
  extracted           Json?
  created_at          DateTime @default(now()) @db.Timestamptz

  segment Segment @relation(fields: [segment_id], references: [id])

  @@map("sentiment_results")
}

enum JobType {
  transcribe_segment
  render_segment
}

enum JobStatus {
  pending
  processing
  done
  failed
}

model Job {
  id           String    @id @default(uuid()) @db.Uuid
  type         JobType
  payload      Json
  status       JobStatus @default(pending)
  attempts     Int       @default(0)
  // Ceiling on attempts before a failing job stops requeuing and moves to
  // the terminal `failed` status instead. Lives on the row (not a global
  // config constant) so a future job type can override it at creation time
  // without a schema change. See src/worker.ts.
  max_attempts Int       @default(5)
  // Backoff scheduling: claimJob only picks up `pending` jobs where
  // run_after <= now(). Bumped forward (not to `now()`) on every retry -
  // see backoffDelayMs in src/worker.ts. Defaults to `now()` so a freshly
  // created job is immediately claimable, same as before this column
  // existed.
  run_after    DateTime  @default(now()) @db.Timestamptz
  // Set to a fresh random token on every claim (including a visibility-
  // timeout reclaim) and checked on every write back to this row (done /
  // retry / terminal-fail). A worker whose job was reclaimed out from under
  // it - because it looked abandoned - fails this check on its own
  // completion and no-ops instead of clobbering whatever claimed it next.
  // See src/worker.ts.
  lock_token   String?   @db.Uuid
  last_error   String?
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz

  // Every poll cycle filters on (status, run_after) via claimJob's WHERE
  // clause - see src/worker.ts.
  @@index([status, run_after])
  @@map("jobs")
}

enum RenderedVideoStatus {
  pending
  rendering
  rendered
  failed
}

model RenderedVideo {
  id         String              @id @default(uuid()) @db.Uuid
  segment_id String              @unique @db.Uuid
  video_key  String
  status     RenderedVideoStatus @default(pending)
  created_at DateTime            @default(now()) @db.Timestamptz
  updated_at DateTime            @updatedAt @db.Timestamptz

  segment Segment @relation(fields: [segment_id], references: [id])

  @@map("rendered_videos")
}

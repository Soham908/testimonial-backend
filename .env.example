# Server
PORT=3000

# Postgres — single source of truth for data + job state (see backend-plan.html #schema, #pipeline)
DATABASE_URL=postgresql://user:password@localhost:5432/testimonial_backend

# Auth — Phase A session tokens (see backend-plan.html #identity)
SESSION_SECRET=

# S3 — raw segment uploads + rendered reel storage (see backend-plan.html #schema, #principles)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ElevenLabs Scribe — transcription (see backend-plan.html #pipeline)
ELEVENLABS_API_KEY=

# Claude API — sentiment + theme extraction (see backend-plan.html #pipeline)
ANTHROPIC_API_KEY=

# nexrender — branded reel rendering (see backend-plan.html #pipeline, #diagram)
NEXRENDER_SERVER_URL=
NEXRENDER_API_KEY=

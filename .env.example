# Server
PORT=3000

# Postgres — single source of truth for data + job state (see backend-plan.html #schema, #pipeline)
DATABASE_URL=postgresql://user:password@localhost:5432/testimonial_backend

# Auth — Phase A session tokens (see backend-plan.html #identity)
SESSION_SECRET=

# S3 — raw segment uploads + rendered reel storage (see backend-plan.html #schema, #principles)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ElevenLabs Scribe — transcription (see backend-plan.html #pipeline)
ELEVENLABS_API_KEY=

# Gemini API — sentiment + theme extraction (testing-phase swap for Claude, see backend-plan.html #pipeline)
GEMINI_API_KEY=

# nexrender-cloud — branded reel rendering
# Must include the /api segment — easy to drop by mistake, and the API works
# just enough without it to make the omission non-obvious until a render call
# actually fails.
NEXRENDER_SERVER_URL=https://api.nexrender.com/api
NEXRENDER_API_KEY=

# Feature flag — set to "true" to enable reel rendering (render_segment jobs +
# nexrender calls). Defaults to disabled: the branded template isn't ready yet
# and this shouldn't block internal testing. The frontend has its own
# independent EXPO_PUBLIC_ENABLE_REEL_RENDERING flag — keep both in sync.
ENABLE_REEL_RENDERING=false

# Feature flag — reserved for future internal/debug routes. Nothing is
# gated behind this right now (the one route it used to gate, GET
# /segments/sentiment, was removed once GET /dashboard/* superseded it —
# see ENABLE_DASHBOARD_ENDPOINTS below). Left in place, unused, since a
# genuinely internal/debug-only route is a plausible future need.
ENABLE_DEV_ENDPOINTS=false

# Feature flag — set to "true" to register the internal admin/reporting
# GET /dashboard/* routes (see src/routes/dashboard.ts). Defaults to
# disabled: those routes return client-wide sentiment/moderation/complaint
# data across every distributor of a client, not scoped to any one
# distributor — never enable this in a shared/production environment.
ENABLE_DASHBOARD_ENDPOINTS=false

# Feature flag — set to "true" to register POST /register (self-registration
# for internal test participants, see src/routes/register.ts). Defaults to
# disabled: it's an unauthenticated endpoint that creates Distributor rows,
# always under the fixed internal-test Client — never enable this once real
# IFB provisioning exists.
ENABLE_SELF_REGISTRATION=false

# Minimum installed app version the frontend should accept, surfaced via
# GET /distributors/me (post-auth only — no unauthenticated version-gate
# endpoint yet). Optional; defaults to "0.0.0" (no gate) if unset.
MIN_APP_VERSION=

# Comma-separated allowlist of browser origins allowed to call this API via
# CORS — only actually matters for the internal dashboard's browser-based
# fetches (see src/routes/dashboard.ts); the mobile app is a native client
# and never goes through CORS. Optional; defaults to an empty list (no
# origin allowed — fails closed, not a wildcard) if unset. For local
# dashboard dev against Vite's default port:
# CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=

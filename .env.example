# Server
PORT=3000

# Postgres — single source of truth for data + job state (see backend-plan.html #schema, #pipeline)
DATABASE_URL=postgresql://user:password@localhost:5432/testimonial_backend

# Auth — Phase A session tokens (see backend-plan.html #identity)
SESSION_SECRET=

# S3 — raw segment uploads + rendered reel storage (see backend-plan.html #schema, #principles)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ElevenLabs Scribe — transcription (see backend-plan.html #pipeline)
ELEVENLABS_API_KEY=

# Gemini API — sentiment + theme extraction (testing-phase swap for Claude, see backend-plan.html #pipeline)
GEMINI_API_KEY=

# nexrender-cloud — branded reel rendering
# Must include the /api segment — easy to drop by mistake, and the API works
# just enough without it to make the omission non-obvious until a render call
# actually fails.
NEXRENDER_SERVER_URL=https://api.nexrender.com/api
NEXRENDER_API_KEY=

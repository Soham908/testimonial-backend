# Server
PORT=3000

# Postgres — single source of truth for data + job state (see backend-plan.html #schema, #pipeline)
DATABASE_URL=postgresql://user:password@localhost:5432/testimonial_backend

# Auth — Phase A session tokens (see backend-plan.html #identity)
SESSION_SECRET=

# S3 — raw segment uploads + rendered reel storage (see backend-plan.html #schema, #principles)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ElevenLabs Scribe — transcription (see backend-plan.html #pipeline)
ELEVENLABS_API_KEY=

# Gemini API — sentiment + theme extraction (testing-phase swap for Claude, see backend-plan.html #pipeline)
GEMINI_API_KEY=

# nexrender-cloud — branded reel rendering
# Must include the /api segment — easy to drop by mistake, and the API works
# just enough without it to make the omission non-obvious until a render call
# actually fails.
NEXRENDER_SERVER_URL=https://api.nexrender.com/api
NEXRENDER_API_KEY=

# Feature flag — set to "true" to enable reel rendering (render_segment jobs +
# nexrender calls). Defaults to disabled: the branded template isn't ready yet
# and this shouldn't block internal testing. The frontend has its own
# independent EXPO_PUBLIC_ENABLE_REEL_RENDERING flag — keep both in sync.
ENABLE_REEL_RENDERING=false

# Feature flag — set to "true" to register internal/debug routes (currently
# just GET /segments/sentiment, see src/routes/dev.ts). Defaults to disabled:
# that route returns client-wide sentiment/moderation/complaint data across
# every distributor of a client, not scoped to any one distributor — never
# enable this in a shared/production environment.
ENABLE_DEV_ENDPOINTS=false

# Feature flag — set to "true" to register POST /register (self-registration
# for internal test participants, see src/routes/register.ts). Defaults to
# disabled: it's an unauthenticated endpoint that creates Distributor rows,
# always under the fixed internal-test Client — never enable this once real
# IFB provisioning exists.
ENABLE_SELF_REGISTRATION=false
